{
  "name": "eslint-import-resolver-vite",
  "version": "2.2.0",
  "description": "Vite module resolution plugin for eslint-plugin-import and eslint-plugin-import-x.",
  "keywords": [
    "eslint",
    "vite",
    "import resolver"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pzmosquito/eslint-import-resolver-vite"
  },
  "author": {
    "name": "pzmosquito",
    "email": "pzmosquito@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pzmosquito/eslint-import-resolver-vite/issues"
  },
  "homepage": "https://github.com/pzmosquito/eslint-import-resolver-vite#readme",
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs.js"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "^29.5.0",
    "vite": "^6 || ^7 || ^8"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "resolve": "^1.22.8"
  },
  "scripts": {
    "test": "jest --watchAll",
    "test:ci": "jest --watchAll=false",
    "test:e2e": "npm run build && node scripts/e2e.js",
    "build": "vite build",
    "test:matrix": "node scripts/test-matrix.js",
    "prepublishOnly": "npm run build",
    "verify:dist": "node scripts/verify-dist.js"
  }
}
