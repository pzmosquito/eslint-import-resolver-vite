{
  "name": "eslint-import-resolver-vite",
  "version": "2.1.0",
  "description": "Vite module resolution plugin for eslint-plugin-import and eslint-plugin-import-x.",
  "keywords": [
    "eslint",
    "vite",
    "import resolver"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pzmosquito/eslint-import-resolver-vite"
  },
  "author": {
    "name": "pzmosquito",
    "email": "pzmosquito@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pzmosquito/eslint-import-resolver-vite/issues"
  },
  "homepage": "https://github.com/pzmosquito/eslint-import-resolver-vite#readme",
  "main": "./dist/index.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/index.cjs.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "peerDependencies": {
    "eslint-plugin-import": "^2.26.0 || ^3.0.0-beta.1",
    "eslint-plugin-import-x": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-import": {
      "optional": true
    },
    "eslint-plugin-import-x": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "resolve": "^1.22.8"
  },
  "scripts": {
    "test": "jest",
    "testWatch": "jest --watchAll",
    "prepublishOnly": "npx vite build"
  }
}
